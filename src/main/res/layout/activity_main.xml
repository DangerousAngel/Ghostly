<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghost_black">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/ghost_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Ghost Shield / Status Icon -->
        <ImageButton
            android:id="@+id/shieldBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ghost_mode"
            android:padding="8dp"
            android:src="@drawable/ic_shield" />

        <!-- Address / Search Bar Pill -->
        <LinearLayout
            android:id="@+id/urlBarLayout"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/lockIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="SSL"
                android:src="@drawable/ic_lock"
                android:visibility="gone" />

            <EditText
                android:id="@+id/urlEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_or_enter_url"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/ghost_text_primary"
                android:textColorHint="@color/ghost_text_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/refreshOrStopBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh"
                android:padding="6dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_below="@id/topBar"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/ghost_progress"
        android:visibility="gone" />

    <!-- Find In Page Bar (Hidden by default) -->
    <LinearLayout
        android:id="@+id/findInPageBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/progressBar"
        android:background="@color/ghost_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findQueryEditText"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_bar"
            android:hint="@string/find_in_page"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/ghost_text_primary"
            android:textColorHint="@color/ghost_text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/findMatchesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/ghost_text_secondary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/findPrevBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/findNextBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_forward" />

        <ImageButton
            android:id="@+id/findCloseBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:background="@color/ghost_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="14dp"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/forwardBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:padding="14dp"
            android:src="@drawable/ic_forward" />

        <!-- Ghost Panic / Instant Wipe Button (Central Action) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/panicWipeBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_burn_btn"
                android:contentDescription="@string/panic_wipe"
                android:padding="10dp"
                android:src="@drawable/ic_burn" />
        </FrameLayout>

        <!-- Tabs Button with Badge -->
        <FrameLayout
            android:id="@+id/tabsBtnLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/tabsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/tabs_title"
                android:src="@drawable/ic_tabs" />

            <TextView
                android:id="@+id/tabsCountBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tabs_badge"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/ghost_tab_badge_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="14dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/bottomBar"
        android:background="@color/ghost_border" />

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBar"
        android:background="@color/ghost_border" />

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomDivider"
        android:layout_below="@id/topDivider">

        <!-- Ghost Home Screen (Included Layout) -->
        <include
            android:id="@+id/homeLayout"
            layout="@layout/view_ghost_home" />
    </FrameLayout>

</RelativeLayout>
